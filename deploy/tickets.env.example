# Copia este archivo en la EC2 como /home/ec2-user/tickets.env y completa los valores.
# NO subas el archivo real al repositorio.

# Oracle Autonomous Database (la wallet va descomprimida en /home/ec2-user/wallet)
DB_URL=jdbc:oracle:thin:@ticketsdb_low?TNS_ADMIN=/app/wallet
DB_USER=ADMIN
DB_PASSWORD=TU_CONTRASENA_DE_ADMIN

# S3 (las credenciales las entrega el rol LabInstanceProfile de la EC2)
S3_BUCKET=NOMBRE_DE_TU_BUCKET
AWS_REGION=us-east-1
S3_SUBIDA_AUTOMATICA=true

# EFS montado en la EC2 y compartido con el contenedor
EFS_PATH=/mnt/efs/tickets
