            "api",
            "tickets"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoCodigo\": \"{{evento}}\",\n  \"usuario\": \"{{usuario}}\",\n  \"asiento\": \"A1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const t = pm.response.json();",
              "pm.collectionVariables.set(\"ticketId\", t.id);",
              "pm.test(\"Ruta S3 evento/usuario/ticket\", () => pm.expect(t.s3Key).to.match(/^.+\\/.+\\/ticket\\d+\\.pdf$/));"
            ]
          }
        }
      ]
    },
